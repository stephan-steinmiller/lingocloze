# Supabase (publishable client keys only — safe for VITE_ exposure).
# Find these in Supabase Dashboard → Project Settings → API, or the Connect dialog.
# The anon/publishable key is public by design (RLS protects data). Never put
# service_role or sb_secret_* keys in VITE_ vars.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_<...>

# Server-side only (never VITE_): used locally for `supabase link` / db push
# via SUPABASE_ACCESS_TOKEN, not by the app itself.
# SUPABASE_ACCESS_TOKEN=sbp_...
